<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opa.permission.mapper.RolePermissionMapper">
    <resultMap id="RolePermissionResultMap" type="com.opa.permission.model.RolePermission">
        <id property="id" column="id"/>
        <result property="roleId" column="role_id"/>
        <result property="permissionId" column="permission_id"/>
        <result property="createdTime" column="created_time"/>
        <result property="updatedTime" column="updated_time"/>
    </resultMap>

    <select id="selectAll" resultMap="RolePermissionResultMap">
        SELECT id, role_id, permission_id, created_time, updated_time
        FROM test.relation_role_permissions
        ORDER BY id
    </select>
</mapper>
