<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opa.permission.mapper.UserRoleMapper">
    <resultMap id="UserRoleResultMap" type="com.opa.permission.model.UserRole">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="roleId" column="role_id"/>
        <result property="grantBy" column="grant_by"/>
        <result property="createdTime" column="created_time"/>
        <result property="updatedTime" column="updated_time"/>
    </resultMap>

    <select id="selectAll" resultMap="UserRoleResultMap">
        SELECT id, user_id, tenant_id, role_id, grant_by, created_time, updated_time
        FROM test.relation_user_roles
        ORDER BY id
    </select>
</mapper>
