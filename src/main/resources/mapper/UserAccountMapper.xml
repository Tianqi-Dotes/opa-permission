<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opa.permission.mapper.UserAccountMapper">
    <resultMap id="UserAccountResultMap" type="com.opa.permission.model.UserAccount">
        <id property="userId" column="user_id"/>
        <result property="username" column="username"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="tenantId" column="tenant_id"/>
        <result property="status" column="status"/>
        <result property="createdTime" column="created_time"/>
        <result property="updatedTime" column="updated_time"/>
    </resultMap>

    <select id="selectByUsername" resultMap="UserAccountResultMap">
        SELECT user_id, username, password_hash, tenant_id, status, created_time, updated_time
        FROM test.users
        WHERE username = #{username}
    </select>
</mapper>
