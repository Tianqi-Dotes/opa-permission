<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.opa.permission.mapper.RoleMapper">
    <resultMap id="RoleResultMap" type="com.opa.permission.model.Role">
        <id property="roleId" column="role_id"/>
        <result property="roleName" column="role_name"/>
        <result property="roleType" column="role_type"/>
        <result property="status" column="status"/>
        <result property="description" column="description"/>
        <result property="createdTime" column="created_time"/>
        <result property="updatedTime" column="updated_time"/>
    </resultMap>

    <select id="selectAll" resultMap="RoleResultMap">
        SELECT role_id, role_name, role_type, status, description, created_time, updated_time
        FROM test.roles
        ORDER BY role_id
    </select>
</mapper>
